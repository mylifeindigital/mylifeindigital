{
  "name": "mylifeindigital",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "My Life In Digital monorepo",
  "workspaces": [
    "web",
    "experiments/ts-core-utils"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:utils": "npm run build --workspace=ts-core-utils",
    "build:web": "npm run build --workspace=web",
    "compare:preview-parity": "npm run compare:preview-parity --workspace=web",
    "preview-worker:poc": "npm run preview-worker:poc --workspace=web",
    "new-content": "tsx scripts/new-content.ts",
    "new-session": "tsx scripts/new-session.ts",
    "sync:stories": "tsx scripts/sync-stories.ts",
    "test": "npm run test:scripts && npm run test:web",
    "test:scripts": "tsx --test scripts/content/*.test.ts web/scripts/utils/*.test.ts",
    "test:web": "npm test --workspace=web",
    "typecheck": "npm run typecheck:scripts && npm run typecheck:web-scripts && npm run typecheck:web && npm run typecheck:tests",
    "typecheck:scripts": "tsc",
    "typecheck:tests": "npm run typecheck:tests --workspace=web",
    "typecheck:web-scripts": "tsc --noEmit --project web/tsconfig.scripts.json",
    "typecheck:web": "npm run typecheck --workspace=web",
    "update-date": "tsx scripts/update-date.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
