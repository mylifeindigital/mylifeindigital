# Local content-tooling configuration (repository root .env is the canonical
# source for these values — see CR-021; web/.env stays web-specific).

# REQUIRED: path to the publishable content directory — the folder that
# directly contains pages/, posts/, technical-sessions/ and index.md.
# Publishable Markdown lives in the mylifeindigital.content repository
# (CR-020); keep a sibling checkout and point CONTENT_DIR at it. Relative
# paths resolve against this repository's root.
CONTENT_DIR=../mylifeindigital.content/content
