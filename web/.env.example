# Site Configuration
SITE_TITLE=Markdown Blog

# Server Configuration
PORT=3000

# OpenAI API key for generating image prompts
# Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Cloudflare API credentials for image generation
# Get these from Cloudflare dashboard: https://dash.cloudflare.com/

# Your Cloudflare account ID (found in dashboard URL or Overview page)
CLOUDFLARE_ACCOUNT_ID=yRgoTKFUtiPH3ujXnLJjcBPwizl6ouUaQPwyZuZuq

# API token with Workers AI and R2 permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Workers AI, R2 Write
CLOUDFLARE_API_TOKEN=yRgoTKFUtiPH3ujXnLJjcBPwizl6ouUaQPwyZuZuq

# R2 credentials (for S3-compatible API access)
# Create at: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
R2_ACCESS_KEY_ID=y46436f3f808de420ea96d1052d2724c1
R2_SECRET_ACCESS_KEY=y7e1c17e9527514891fae60c77d6389b381db4bf0ab5debf724170290bfa74109

# Optional: Public URL for images (defaults to R2 public URL)
# R2_PUBLIC_URL=https://images.mylifeindigital.co.za

# Everything above is build-time only, read by scripts under web/scripts/.
# The deployed Worker holds no credentials: CR-029 removed the admin
# dashboard, and with it the GitHub write token, the Cloudflare Access
# allowlist, and the OpenAI key used for editor AI transforms. Do not add
# credentials to wrangler.toml [vars] or Worker secrets without a change
# request explaining what runtime need they serve.
